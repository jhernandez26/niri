-- Conky configuration for Niri / Wayland
conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    default_color = '#c0caf5',
    default_outline_color = '#1a1b26',
    default_shade_color = '#1a1b26',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'Sans:size=10',
    gap_x = 30,
    gap_y = 60,
    minimum_height = 5,
    minimum_width = 290,
    net_avg_samples = 2,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_x = true,
    out_to_wayland = true,
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'override',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 180,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    show_graph_range = false,
    show_graph_scale = false,
    stippled_borders = 0,
    update_interval = 1.0,
    uppercase = false,
    use_spacer = 'none',
    use_xft = true,
    color1 = '#7aa2f7', -- Accent Blue
    color2 = '#bb9af7', -- Purple
    color3 = '#7dcfff', -- Cyan
    color4 = '#e0af68', -- Yellow/Orange
    color5 = '#9ece6a', -- Green
}

conky.text = [[
${color1}${font Sans:bold:size=11}SISTEMA ${hr 2}${font}
${color1}Host:$color $nodename ${alignr}${color1}OS:$color $sysname
${color1}Kernel:$color $kernel
${color1}Uptime:$color $uptime

${color1}${font Sans:bold:size=11}CONSUMO DE MEMORIA (RAM) ${hr 2}${font}
${color1}RAM Usada:$color $mem / $memmax ${alignr}${color1}$memperc%
${color1}${membar 6}
${color1}${memgraph 30,290 7aa2f7 7dcfff}
${color1}Swap Usada:$color $swap / $swapmax ${alignr}${color1}$swapperc%
${color1}${swapbar 6}

${color1}${font Sans:bold:size=11}PROCESADOR (CPU) ${hr 2}${font}
${color1}Frecuencia:$color $freq_g GHz ${alignr}${color1}Uso:$color $cpu%
${color1}${cpubar 6}
${color1}${cpugraph 30,290 7aa2f7 bb9af7}

${color1}${font Sans:bold:size=11}CONTENEDORES ROOT (PODMAN) ${hr 2}${font}
${color1}Contenedores activos:$color ${color5}${exec sudo -n podman ps -q 2>/dev/null | wc -l} activo(s)$color
${color3}${exec sudo -n podman ps --format "{{.Names}} ({{.Image}})" 2>/dev/null | sed 's/^/ • /'}

${color1}${font Sans:bold:size=11}MÁQUINAS VIRTUALES ${hr 2}${font}
${color1}KVM / Virsh:$color ${exec virsh list --all 2>/dev/null | grep -c 'ejecutando\|apagado'} registrada(s)

${color1}${font Sans:bold:size=11}ALMACENAMIENTO ${hr 2}${font}
${color1}/ (Raíz):$color ${fs_used /} / ${fs_size /} ${alignr}${color1}${fs_used_perc /}%
${color1}${fs_bar 6 /}

${color1}${font Sans:bold:size=11}TOP PROCESOS (POR RAM) ${hr 2}${font}
${color1}Nombre              PID     MEM. REAL   RAM%
${color2} ${top_mem name 1} ${top_mem pid 1} ${top_mem mem_res 1}  ${top_mem mem 1}%
$color ${top_mem name 2} ${top_mem pid 2} ${top_mem mem_res 2}  ${top_mem mem 2}%
$color ${top_mem name 3} ${top_mem pid 3} ${top_mem mem_res 3}  ${top_mem mem 3}%
$color ${top_mem name 4} ${top_mem pid 4} ${top_mem mem_res 4}  ${top_mem mem 4}%
]]
